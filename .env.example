# ============================================================================
# Lead Bot Template — environment variables
# Copy this file to .env (`cp .env.example .env`) and fill in the values.
# ============================================================================

# ---------- App ------------------------------------------------------------
APP_ENV=local                 # local | dev | prod (affects logging defaults)
APP_DEBUG=true                # set false in prod
APP_NAME=Lead Bot

# ---------- Telegram bot ---------------------------------------------------
# Get your token from https://t.me/BotFather → /newbot
BOT_TOKEN=123456:ABC

# polling (simplest, default) — bot opens a long-poll to Telegram
# webhook (for prod with HTTPS) — bot exposes an HTTP endpoint
BOT_MODE=polling
BOT_WEBHOOK_URL=https://example.com/webhook/telegram
BOT_WEBHOOK_SECRET=change-me

# Comma-separated Telegram user IDs of admins. Get yours from @userinfobot.
# These users see the /admin panel and can manage leads.
ADMIN_IDS=123456789,987654321

# Bearer token for the FastAPI /admin/* HTTP endpoints (optional integration).
ADMIN_API_TOKEN=change-me-admin-token

# Optional: forward new-lead notifications to a group chat (negative number for groups).
MANAGER_GROUP_ID=

# ---------- Database & cache ----------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/leadbot
REDIS_URL=redis://redis:6379/0

# Used ONLY by docker-compose.prod.yml to provision the Postgres container.
# Keep these in sync with DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password-for-prod
POSTGRES_DB=leadbot

# ---------- Behaviour ------------------------------------------------------
TIMEZONE=Europe/Moscow

# Anti-spam and resource limits.
RATE_LIMIT_MESSAGES_PER_MINUTE=20
MAX_LEADS_PER_10_MINUTES=3
MAX_FILES_PER_LEAD=5
MAX_FILE_SIZE_MB=20
FSM_TTL_HOURS=24

# Drop messages queued in Telegram while the bot was offline (avoids replaying old commands).
DROP_PENDING_UPDATES=false

# ---------- Observability --------------------------------------------------
# Set to your Sentry DSN to enable error reporting. Leave empty to disable.
SENTRY_DSN=

# ---------- Outbound webhooks (Tier 3.A) -----------------------------------
# Comma-separated HTTPS endpoints to POST lead events to. Empty = disabled.
# Each endpoint receives the same JSON envelope:
#   { "event": "lead.created" | "lead.status_changed" | "lead.deleted",
#     "occurred_at": "2026-05-19T10:00:00+00:00",
#     "data": { ...lead fields... } }
# When WEBHOOK_SECRET is set, the request also carries X-Webhook-Signature:
#   sha256=<hex HMAC-SHA256 of the body using the secret>
# Receiver should verify this header to confirm the call came from your bot.
WEBHOOK_URLS=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ---------- Outbound email (Tier 3.B) --------------------------------------
# SMTP for emailing admins on every new lead. Empty SMTP_HOST = disabled.
# Tested with Gmail (smtp.gmail.com:587), Yandex, mail.ru, SendGrid, Mailgun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Comma-separated admin recipient list.
SMTP_ADMIN_EMAILS=

# ---------- Content profile ------------------------------------------------
# Selects which YAML profile under app/bot/content/<name>/ to load.
#
# Bundled profiles (run `make profiles` to list with company names):
#   default          — generic LeadBot demo
#   auto_service     — автосервис «Гараж 24»
#   beauty_salon     — студия красоты «Линия»
#   medical_clinic   — медцентр «Меридиан»
#
# Create your own: `make new-client SLUG=acme PROFILE=auto_service`, then edit
# the YAML files in app/bot/content/acme/ and set CONTENT_PROFILE=acme.
CONTENT_PROFILE=default
